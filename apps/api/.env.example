DATABASE_URL="postgresql://postgres:123456@localhost:5432/bora_bilgic_teknik_store?schema=public"
PORT=4010
HOST="127.0.0.1"
# "production" (veya WEB_URL https ile başladığında) refresh çerezi secure
# olarak işaretlenir ve yalnızca HTTPS üzerinden gönderilir. Lokal http
# geliştirmede "development" bırakın, aksi halde çerez tarayıcıya düşmez.
NODE_ENV="development"
WEB_URL="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# ---------------------------------------------------------------------------
# SMTP (e-posta gönderimi)
# ---------------------------------------------------------------------------
# Kayıt doğrulama ve hoş geldin e-postaları bu ayarlarla gönderilir. Değerler
# boş bırakılırsa mail servisi e-postaları konsola yazar; auth akışı lokal
# geliştirmede çalışmaya devam eder.
#
#   SMTP_HOST  -> SMTP sunucusu (ör. smtp.gmail.com)
#   SMTP_PORT  -> genellikle 587 (STARTTLS) veya 465 (TLS)
#   SMTP_USER  -> SMTP kullanıcı adı
#   SMTP_PASS  -> SMTP şifresi / uygulama şifresi
#   SMTP_FROM  -> gönderici adresi (ör. "Bora Bilgic Teknik <no-reply@site.com>")
#
# REQUIRE_EMAIL_VERIFICATION="1" iken giriş, kullanıcı e-postasını
# doğrulayana kadar engellenir (403). Boş ya da "0" iken doğrulama zorunlu
# değildir; SMTP yapılandırılmadan doğrulanmamış hesaplar kilitlenmez.
# Gmail ile gonderim (orn. borabilgicdestek@gmail.com):
#   SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", SMTP_USER=<gmail adresi>,
#   SMTP_PASS=<Google Uygulama Sifresi - 16 haneli; normal sifre DEGIL!>,
#   SMTP_FROM="Bora Bilgic Teknik <ayni gmail adresi>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
REQUIRE_EMAIL_VERIFICATION="0"

# ---------------------------------------------------------------------------
# Cloudflare R2 (product media storage)
# ---------------------------------------------------------------------------
# All five values are required before media upload will work. If any are
# missing, POST /api/v1/admin/media/upload returns an explicit configuration
# error rather than an opaque 500.
#
# How to obtain each value in the Cloudflare dashboard:
#
#   R2_ACCOUNT_ID      -> R2 overview page, right-hand sidebar ("Account ID").
#                         This is the 32-character hex string, NOT the
#                         "<account>.r2.cloudflarestorage.com" host.
#
#   R2_ACCESS_KEY_ID   -> R2 > Manage R2 API Tokens > Create API token.
#   R2_SECRET_ACCESS_KEY  Use "Object Read & Write" permissions scoped to the
#                         single media bucket. The secret is shown only once,
#                         at creation time.
#
#   R2_BUCKET_NAME     -> The bucket name you created, e.g.
#                         "bora-bilgic-teknik-media".
#
#   R2_PUBLIC_BASE_URL -> The public base URL objects are served from.
#                         Production now uses the same public site domain as
#                         the R2 custom domain:
#                           https://borabilgic.net.tr
#                         Uploaded keys are stored below products/images,
#                         products/posters, products/videos and
#                         orders/invoices. The nginx config proxies those
#                         prefixes to the R2 public bucket so the browser never
#                         needs to request the r2.dev host directly.
#                         For local/dev you may still use a public
#                         https://pub-<hash>.r2.dev URL.
#                         Must be a full URL with scheme and no trailing slash.
#
# R2 objects are written under the products/images, products/posters and
# products/videos prefixes and served with a one-year immutable cache header,
# so the key is never reused for different content.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL="https://borabilgic.net.tr"

# ---------------------------------------------------------------------------
# PayTR (hosted payment iframe)
# ---------------------------------------------------------------------------
# All three values come from the PayTR merchant panel (Magaza > Entegrasyon
# Bilgileri). While any of them is empty, checkout answers 503 instead of
# opening the iframe; orders are only created after the verified callback.
#
#   PAYTR_MERCHANT_ID    -> numeric mağaza numarası (ör. 123456)
#   PAYTR_MERCHANT_KEY   -> entegrasyon anahtarı
#   PAYTR_MERCHANT_SALT  -> entegrasyon salt'ı
#   PAYTR_TEST_MODE      -> "1" test kartlarıyla deneme, "0" canli tahsilat.
#                           Bos birakilirsa guvenli secenek olan "1" sayilir.
#
# PayTR panelinde bildirim (callback) URL'si olarak
# https://<api-alan-adiniz>/api/v1/payments/paytr/callback tanimlanmalidir;
# ok/fail yonlendirmeleri WEB_URL uzerinden /odeme/basarili ve
# /odeme/basarisiz adreslerine gider. Lokal gelistirmede ngrok gibi bir
# tunel acip adresi panele yazmak gerekir, aksi halde callback ulasmaz.
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_TEST_MODE="1"

# Checkout fatura adiminda alinan TC kimlik numarasi AES-256-GCM ile
# sifrelenir. 32 byte base64 onerilir:
#   openssl rand -base64 32
BILLING_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Yurtiçi Kargo entegrasyonu
# ---------------------------------------------------------------------------
# Kargo gönderi oluşturma ve takip senkronizasyonu bu bilgilerle çalışır.
# DİKKAT: Entegrasyon kimlik bilgileri Yurtiçi Kargo ile yapılacak
# entegrasyon anlaşmasından sonra sağlanacaktır; o zamana kadar boş
# bırakılmalıdır. Üç bilgi (kullanıcı adı, şifre, müşteri/abone no) tamamlan-
# madığı sürece kargo uç noktaları 503 "kullanım dışı" yanıtı verir.
#
#   YURTICI_KARGO_USERNAME     -> KOPS web servisi kullanıcı adı (ör. "YKTEST" test)
#   YURTICI_KARGO_PASSWORD     -> KOPS web servisi şifresi
#   YURTICI_KARGO_CUSTOMER_ID  -> müşteri/abone numarası
#   YURTICI_KARGO_API_URL      -> WSDL adresi; boş bırakılırsa CANLI adres
#                                 varsayılır:
#                                 https://webservices.yurticikargo.com/KOPSWebServices/ShippingOrderDispatcherServices?wsdl
#                                 TEST ortamı için (IP yetkilendirmesi sonrası):
#                                 http://testwebservices.yurticikargo.com:9090/KOPSWebServices/ShippingOrderDispatcherServices?wsdl
#                                 veya https://testwebservices.yurticikargo.com/KOPSWebServices/ShippingOrderDispatcherServices?wsdl
#   YURTICI_KARGO_TIMEOUT_MS   -> istek zaman aşımı (ms), varsayılan 15000
#   YURTICI_KARGO_RETURN_FIELD_ID -> RMA iade kodunun özel alan numarası
#                                 (ssfldvn). Canlıda 16 ("İade Onay Kodu");
#                                 test kullanıcısında tanım yoktur, 53 veya 3
#                                 ile test edilir. Varsayılan 16.
#
# ÖNEMLİ — Erişim yetkilendirme: Yurtiçi Kargo web servisleri yalnızca önceden
# tanıtılmış sabit IP'lerden erişime açıktır. Sunucunuzun (VPS) çıkış IP'sini
# "Web Servis Giden Kargo Teknik Döküman" s.4'teki Erişim Yetkilendirme
# Formu ile Bölge Müdürlüğü Satış Temsilcinize iletip tanıtın. Test ortamı
# kullanıcı adı: YKTEST (dokümanlardaki örnekler); canlı kullanıcı bilgileri
# Yurtiçi Kargo'dan e-posta ile gelir ve YALNIZCA .env dosyasına yazılır.
YURTICI_KARGO_API_URL=""
YURTICI_KARGO_USERNAME=""
YURTICI_KARGO_PASSWORD=""
YURTICI_KARGO_CUSTOMER_ID=""
YURTICI_KARGO_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Operasyonel ayarlar (tum degerler opsiyoneldir; bos birakilirsaniz kod
# varsayilani kullanilir)
# ---------------------------------------------------------------------------
# Rate limit esikleri (express-rate-limit, IP bazli). Kisa pencere login /
# refresh / logout / checkout icin; saatlik pencere register / verify-email /
# resend-verification akislari icin kullanilir.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_HOURLY_WINDOW_MINUTES=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_VERIFY_EMAIL_MAX=20
RATE_LIMIT_RESEND_VERIFICATION_MAX=5
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_LOGOUT_MAX=30
RATE_LIMIT_CHECKOUT_MAX=20

# Odeme penceresi (dakika): bu sure icinde tamamlanmayan odeme denemeleri
# suresi dolmus sayilir ve rezerve ettikleri stok iade edilir.
PAYMENT_WINDOW_MINUTES=30
# Bayat odeme denemelerini temizleyen arka plan sweep periyodu (dakika).
SWEEP_INTERVAL_MINUTES=10
# PayTR istekleri icin zaman asimi (ms).
PAYTR_TIMEOUT_MS=15000

# Refresh cerezi secure bayragi icin zorunlu override. '1' her zaman secure,
# '0' hicbir zaman secure; bos birakilirsa NODE_ENV=production veya https
# WEB_URL turevi kullanilir (lokal http gelistirmede cerez calisir).
COOKIE_SECURE=""

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# Sitemap.xml üretiminde kullanilan maagaza kok adresi (sitemap ve kanonik
# linkler bu degerle uretilir).
PUBLIC_SITE_URL="https://borabilgic.net.tr"

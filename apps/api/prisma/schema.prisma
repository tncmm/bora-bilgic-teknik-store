generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
}

/**
 * Payment is tracked separately from OrderStatus on purpose. OrderStatus is the
 * fulfilment axis and is consumed by compile-time-exhaustive structures
 * (admin orderStatusSchema, the storefront progress flow, and the headline /
 * support copy maps). Merging the two would let an admin ship an unpaid order,
 * and would make "shipped" and "payment failed" mutually exclusive when they
 * are in fact orthogonal.
 */
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id               String           @id @default(cuid())
  firstName        String
  lastName         String
  email            String           @unique
  passwordHash     String
  role             Role             @default(CUSTOMER)
  emailVerified    Boolean          @default(false)
  verifyToken      String?          @unique
  verifyTokenExpiry DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  addresses        Address[]
  cart             Cart?
  wishlist         Wishlist?
  orders           Order[]
  paymentAttempts  PaymentAttempt[]
  themePreference  ThemePreference?
}

enum AttemptStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String?
  badge       String?
  imageUrl    String?
  linkUrl     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  ctaText   String?
  ctaLink   String?
  imageUrl  String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A checkout in flight: holds the merchant_oid and the full order payload
// while PayTR collects the card. An Order row is only created once the
// callback confirms the money, so unpaid checkouts never become "orders".
model PaymentAttempt {
  id                 String        @id @default(cuid())
  merchantOid        String        @unique
  status             AttemptStatus @default(PENDING)
  total              Decimal       @db.Decimal(10, 2)
  currency           String        @default("TL")
  shippingName       String
  shippingPhone      String
  shippingCity       String
  shippingDistrict   String
  shippingAddressLine String
  notes              String?
  items              Json
  failureReason      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model ThemePreference {
  id        String   @id @default(cuid())
  mode      String   @default("system")
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(cuid())
  title      String
  line1      String
  city       String
  district   String
  postalCode String
  country    String   @default("Turkey")
  phone      String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String
  heroTitle       String?
  heroDescription String?
  heroImageUrl    String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  brand            String
  series           String?
  shortDescription String
  description      String
  sku              String        @unique
  badge            String?
  heroTag          String?
  price            Decimal       @db.Decimal(10, 2)
  discountPercent  Int           @default(0)
  stock            Int
  isPublished      Boolean       @default(true)
  isPurchasable    Boolean       @default(false)
  isBestseller     Boolean       @default(false)
  featureTags      String[]      @default([])
  ratingAverage    Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount      Int           @default(0)
  heroImageUrl     String?
  heroTitle        String?
  heroDescription  String?
  gallery          Json?
  packageOptions   Json?
  detailSections   Json?
  categoryId       String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  specs            ProductSpec[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
}

model ProductImage {
  id           String   @id @default(cuid())
  url          String
  alt          String
  isPrimary    Boolean  @default(false)
  kind         String   @default("image")
  thumbnailUrl String?
  mimeType     String?
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        String   @id @default(cuid())
  name      String
  value     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String    @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, productId])
}

model Order {
  id                  String       @id @default(cuid())
  orderNumber         String       @unique
  status              OrderStatus  @default(PENDING)
  total               Decimal      @db.Decimal(10, 2)
  shippingName        String
  shippingPhone       String
  shippingCity        String
  shippingDistrict    String
  shippingAddressLine String
  notes               String?
  userId              String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // --- Payment (PayTR) -------------------------------------------------
  // paymentRef is the merchant_oid exchanged with PayTR. Nullable and unique:
  // Postgres permits many NULLs, so orders created before this column existed
  // are unaffected.
  paymentStatus         PaymentStatus @default(PENDING)
  paymentMethod         String? // 'card'
  paymentRef            String?    @unique
  paymentCurrency       String?
  paymentAmount         Decimal?   @db.Decimal(10, 2) // actually charged, incl. installments
  paymentType           String? // 'card' | 'eft'
  paidAt                DateTime?
  paymentNotifiedAt     DateTime?
  paymentFailureCode    String?
  paymentFailureMessage String?

  items OrderItem[]
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([paymentStatus, createdAt]) // expiry sweep
  @@index([userId, paymentStatus]) // "my orders" filtering
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}
